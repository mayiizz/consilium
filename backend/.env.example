# Application
APP_NAME=Consilium API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database — use localhost when running uvicorn on your Mac.
# Start dependencies: docker compose up -d mongodb redis
MONGODB_URI=mongodb://localhost:27017/consilium
MONGODB_DB_NAME=consilium

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Groq (optional — copilot/extraction degrade gracefully without key)
GROQ_API_KEY=

# TinyFish (required for Research agent — Search + browser Agent)
# https://docs.tinyfish.ai/authentication
TINYFISH_API_KEY=
TINYFISH_AGENT_BASE=https://agent.tinyfish.ai
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_RUN_TIMEOUT_SECONDS=180
TINYFISH_HTTP_TIMEOUT_SECONDS=60
TINYFISH_MAX_SITES=5
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# GitHub App (optional)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth (create app at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local OAuth via ngrok (GitHub cannot redirect to localhost): run `ngrok http 8000`, then use:
# GITHUB_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.dev/api/github/callback
# Register the same URL on your GitHub OAuth app → Authorization callback URL.
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
FRONTEND_URL=http://localhost:5173

# GitHub webhooks → Kanban task completion
GITHUB_TASK_KEY_PREFIX=MM
GITHUB_PAT=
GITHUB_REQUIRE_PR_MERGE_FOR_DONE=true
GITHUB_REQUIRE_CI_SUCCESS_FOR_DONE=false
GITHUB_CI_WORKFLOW_NAME_ALLOWLIST=

# Kanban automation (Groq + optional RAG)
TASK_AUTOMATION_PROVIDER=groq
TASK_AUTOMATION_MODEL=openai/gpt-oss-120b
TASK_AUTOMATION_MATCH_THRESHOLD=0.78
TASK_AUTOMATION_LOW_CONFIDENCE_THRESHOLD=0.60
TASK_AUTOMATION_EXTRACT_MAX_TOKENS=3072
TASK_AUTOMATION_BOARD_SYNC_MAX_TOKENS=2048
KANBAN_RAG_ENABLED=true
KANBAN_EMBEDDING_MODEL=all-MiniLM-L6-v2
KANBAN_RAG_CHUNK_WORDS=250
KANBAN_RAG_CHUNK_OVERLAP_WORDS=40
KANBAN_RAG_TOP_K=5
KANBAN_RAG_MAX_CONTEXT_CHARS=12000
KANBAN_RAG_MIN_SIMILARITY=0.22
KANBAN_RAG_LATEST_MEETING_SCORE_BOOST=1.12
KANBAN_RAG_QUERIES=
KANBAN_RAG_FALLBACK_TAIL_CHARS=8000
KANBAN_RAG_BOARD_SYNC_ENABLED=true
KANBAN_RAG_BOARD_MAX_TRANSCRIPT_CHARS=10000
TRANSCRIPT_RAG_CACHE_DIR=
TRANSCRIPT_RAG_QA_TOP_K=8
TRANSCRIPT_RAG_QA_MAX_CONTEXT_CHARS=8000
KANBAN_DOCUMENT_RAG_ENABLED=true
KANBAN_DOCUMENT_RAG_MAX_CHARS=6000

# Stale tasks (inactivity → Blockers)
STALE_TASK_AUTO_BLOCKERS_ENABLED=true
STALE_TASK_INACTIVITY_DAYS=3
STALE_TASK_BACKGROUND_INTERVAL_HOURS=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# In-app due reminders (Celery beat hourly)
DUE_REMINDER_DAYS=2

# Topic research agent (TinyFish + Groq)
RESEARCH_MAX_RESULTS=8
RESEARCH_MAX_PAGES=5
RESEARCH_MAX_CHARS_PER_PAGE=8000
RESEARCH_MAX_TOTAL_CHARS=24000
